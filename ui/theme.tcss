/* ForgeX — neon workstation theme */
Screen {
    background: #070b18;
    color: #dce5ff;
}
#login-shell {
    width: 100%;
    height: 100%;
    align: center middle;
    background: #070b18;
}
#login-layout {
    width: 92%;
    max-width: 112;
    height: 32;
    border: round #7254ff;
    background: #0a1024;
}
#login-brand-panel {
    width: 1fr;
    height: 100%;
    align: center middle;
    background: #0b1230;
    border-right: solid #273b77;
}
#login-mark {
    color: #a68cff;
    text-style: bold;
    text-align: center;
    width: 100%;
    height: 3;
    content-align: center middle;
}
#login-brand {
    color: #f0edff;
    text-style: bold;
    text-align: center;
    width: 100%;
    height: 3;
    content-align: center middle;
}
.eyebrow {
    color: #8b9acb;
    text-style: bold;
}
.muted {
    color: #8190b9;
    text-align: center;
}
#login-card {
    width: 1fr;
    height: 100%;
    padding: 2 4;
    border-left: solid #202e58;
}
#login-heading {
    color: #f2edff;
    text-style: bold;
    margin-bottom: 1;
}
#login-card Label {
    color: #a8b8e8;
    margin-top: 1;
}
#login-card Input {
    border: tall #344779;
    background: #090f20;
    color: #f4f1ff;
    margin-bottom: 1;
}
#login-note {
    color: #7585b1;
    margin: 1 0;
}
#login-submit {
    width: 100%;
    margin-top: 1;
    background: #5832d8;
    border: tall #9b7cff;
    color: white;
}
.login-foot {
    margin-top: 2;
}
#dashboard {
    height: 100%;
    width: 100%;
    background: #070b18;
}
#sidebar {
    width: 25;
    height: 1fr;
    padding: 1 1;
    background: #0a1021;
    border-right: solid #263768;
}
#sidebar-logo {
    color: #a58aff;
    text-style: bold;
    text-align: center;
    height: 3;
    content-align: center middle;
}
#sidebar-name {
    color: #f2edff;
    text-style: bold;
    text-align: center;
    margin-bottom: 2;
}
.sidebar-label {
    margin: 1 1;
}
#sidebar Button {
    width: 100%;
    margin-bottom: 1;
    background: #111a35;
    border: tall #293c70;
    color: #c8d4ff;
}
#sidebar Button.-primary {
    background: #342071;
    border: tall #8a68ff;
}
#connection-state {
    color: #69e3a0;
    margin: 1;
}
#sidebar-version {
    color: #7182ae;
    dock: bottom;
    margin: 1;
}
#main-area {
    width: 1fr;
    height: 100%;
    padding: 1 2 0 2;
}
#topbar {
    height: 5;
    border-bottom: solid #283967;
    align: center middle;
}
#welcome-title {
    color: #eeeaff;
    text-style: bold;
    text-style: bold;
}
#online-indicator {
    color: #69e3a0;
    width: 18;
    text-align: right;
}
#search-row {
    height: 5;
    margin-top: 1;
}
#repo-query {
    width: 1fr;
    border: tall #6950d4;
    background: #0a1022;
    color: #f0edff;
}
#search-submit {
    width: 19;
    margin-left: 1;
    background: #5934d8;
    border: tall #a18aff;
    color: white;
}
#quick-actions {
    height: 3;
    margin-bottom: 1;
}
#quick-actions Button {
    margin-right: 1;
    background: #111a34;
    border: tall #2a3a70;
    color: #cbd6ff;
}
#workspace {
    height: 1fr;
    min-height: 14;
}
#results-panel {
    width: 2fr;
    border: round #34477e;
    padding: 1;
    margin-right: 1;
}
#detail-panel {
    width: 1fr;
    min-width: 34;
    border: round #6950c9;
    padding: 1 2;
}
#results-heading, #detail-heading {
    height: 2;
    align: center middle;
}
.section-title {
    color: #c9d4ff;
    text-style: bold;
    width: 1fr;
}
#result-count, #detail-state {
    color: #9d8aff;
}
DataTable {
    height: 1fr;
    background: #080e1d;
    border: none;
}
DataTable > .datatable--header {
    background: #151f40;
    color: #c9d5ff;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: #392477;
    color: #ffffff;
}
#repo-emblem {
    color: #9b7aff;
    text-style: bold;
    text-align: center;
    height: 4;
    content-align: center middle;
}
#repo-title {
    color: #f1edff;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}
#repo-description {
    color: #a9b7dc;
    height: auto;
    max-height: 5;
    margin-bottom: 1;
}
#repo-stats {
    color: #f1c76d;
    margin-bottom: 1;
}
.detail-label {
    margin-top: 1;
}
#repo-full-name, #repo-language, #repo-updated, #repo-license {
    color: #d8e1ff;
}
#open-github {
    width: 100%;
    margin-top: 2;
    background: #171f3d;
    border: tall #6754b8;
    color: #e4dcff;
}
#statusbar {
    height: 2;
    border-top: solid #263768;
    margin-top: 1;
    align: center middle;
}
#status-left {
    color: #70dda0;
    width: 1fr;
}
#status-right {
    color: #7e8db9;
    text-align: right;
    width: 1fr;
}
Footer {
    background: #0b1124;
    color: #a9b8e9;
}
Button:hover {
    background: #352276;
    border: tall #a48bff;
}
Input:focus {
    border: tall #a18aff;
}
